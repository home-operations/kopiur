{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>home-operations/.github:renovate-config"],
  postUpdateOptions: ["pnpmDedupe"],
  packageRules: [
    {
      description: "One PR for the SPA's non-major updates: separate PRs all touch pnpm-lock.yaml, so every merge conflicts and rebases the rest",
      matchManagers: ["npm"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "web UI dependencies",
      groupSlug: "web-ui",
    },
    {
      description: "tracing-opentelemetry is versioned +1 from the opentelemetry-rust monorepo and must move in lockstep; separate PRs each split the graph into two otel versions and fail to compile",
      matchManagers: ["cargo"],
      matchPackageNames: ["opentelemetry*", "tracing-opentelemetry"],
      groupName: "opentelemetry",
      groupSlug: "opentelemetry",
    },
    {
      description: "typescript-eslint's supported TypeScript range (peer typescript >=4.8.4 <6.1.0); raise with it, see typescript-eslint/typescript-eslint#10940",
      matchPackageNames: ["typescript"],
      allowedVersions: "<6.1.0",
    },
    {
      description: "croner 4 rejects shortcut step syntax (`0/15 * * * *`) by default, so a SnapshotSchedule admitted under croner 3 would stop firing after an upgrade; needs `.sloppy_ranges(true)` in `cron_parser()` plus a regression test first, see #433",
      matchManagers: ["cargo"],
      matchPackageNames: ["croner"],
      allowedVersions: "<4.0.0",
    },
    {
      description: "cel 0.15 changes `Context` to take two lifetimes; `identity_context`, and the `context` helpers in `preflight.rs` and `success_expr.rs` must be updated with the bump or the API crate does not compile, see #645",
      matchManagers: ["cargo"],
      matchPackageNames: ["cel"],
      allowedVersions: "<0.15.0",
    },
  ],
}
